+    def test_emits_countries_and_routes_in_stable_line_order(self):
+        groups = {
+            "US": [{"id": "r3", "city": "New York", "country": "US"}],
+            "ES": [
+                {"id": "r1", "city": "Madrid", "country": "ES"},
+                {"id": "r2", "city": "Seville", "country": "ES"},
+            ],
+        }
+
+        self.assertEqual(
+            render_manifest(groups).splitlines(),
+            [
