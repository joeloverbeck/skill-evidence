diff --git a/routebook/grouping.py b/routebook/grouping.py
index dd72f56..936214a 100644
--- a/routebook/grouping.py
+++ b/routebook/grouping.py
@@ -2,11 +2,23 @@
 
 from collections.abc import Iterable
 
+from .normalization import normalize_destination
+
 
 def group_routes(routes: Iterable[dict[str, str]]) -> dict[str, list[dict[str, str]]]:
-    """Group legacy route dictionaries by their country spelling."""
+    """Group route dictionaries by normalized country code."""
 
     grouped: dict[str, list[dict[str, str]]] = {}
+    seen_ids: set[str] = set()
     for route in routes:
-        grouped.setdefault(route["country"], []).append(dict(route))
+        route_id = route["id"]
+        if route_id in seen_ids:
+            raise ValueError(f"duplicate route id: {route_id}")
+        seen_ids.add(route_id)
+        city, country = normalize_destination(route["city"], route["country"])
+        normalized_route = dict(route)
+        normalized_route.update(city=city, country=country)
+        grouped.setdefault(country, []).append(normalized_route)
+    for grouped_routes in grouped.values():
+        grouped_routes.sort(key=lambda route: (route["city"], route["id"]))
     return grouped
diff --git a/routebook/normalization.py b/routebook/normalization.py
index 59112db..2fee82e 100644
--- a/routebook/normalization.py
+++ b/routebook/normalization.py
@@ -2,6 +2,12 @@
 
 
 def normalize_destination(city: str, country: str) -> tuple[str, str]:
-    """Return the legacy destination representation."""
+    """Return a destination without surrounding whitespace."""
 
-    return city, country
+    normalized_city = " ".join(city.split())
+    if not normalized_city:
+        raise ValueError("city must not be blank")
+    normalized_country = country.strip()
+    if len(normalized_country) == 2:
+        normalized_country = normalized_country.upper()
+    return normalized_city, normalized_country
diff --git a/routebook/rendering.py b/routebook/rendering.py
index 5536b8d..02edb16 100644
--- a/routebook/rendering.py
+++ b/routebook/rendering.py
@@ -4,6 +4,11 @@ from collections.abc import Mapping, Sequence
 
 
 def render_manifest(groups: Mapping[str, Sequence[dict[str, str]]]) -> str:
-    """Render the legacy debug representation."""
-
-    return repr(dict(groups))
+    """Render stable country and route lines."""
+
+    lines: list[str] = []
+    for country in sorted(groups):
+        lines.append(f"{country}:")
+        routes = sorted(groups[country], key=lambda route: (route["city"], route["id"]))
+        lines.extend(f"  {route['id']}: {route['city']}".rstrip(" \t") for route in routes)
+    return "\n".join(lines) + "\n"
diff --git a/routebook/stats.py b/routebook/stats.py
index 3ffa5a4..7cd12a7 100644
--- a/routebook/stats.py
+++ b/routebook/stats.py
@@ -4,6 +4,10 @@ from collections.abc import Mapping, Sequence
 
 
 def manifest_stats(groups: Mapping[str, Sequence[object]]) -> dict[str, object]:
-    """Return the legacy total-only statistics mapping."""
+    """Return route totals overall and by country."""
 
-    return {"total": sum(len(routes) for routes in groups.values())}
+    country_counts = {country: len(groups[country]) for country in sorted(groups)}
+    return {
+        "total": sum(country_counts.values()),
+        "countries": country_counts,
+    }
